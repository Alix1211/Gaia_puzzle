{
  "1": {"intro":["오늘도 저부터 시작하시는 거죠?","이번에는 저도 조금 늘었을걸요?"],"hit":["앗, 방금 건 제대로였어요!","에잇, 또 방심했네요!"],"chain":["어어? 아직도 이어져요?"],"counter":["후후, 저도 한 수 둘게요!"],"heal":["조금 쉬었다 해도 돼요! 일단요."]},
  "2": {"intro":["센터의 품격을 보여주세요, 트레이너.","제 차례라면 특별히 기대해도 되겠죠?"],"hit":["어머, 제법 실력이 늘었네요.","그 정도로는 아직 저를 놀라게 못 해요."],"chain":["호호, 오늘은 화려한데요?"],"counter":["주인에게도 배울 건 있답니다."],"heal":["휴식도 관리의 일부예요."]},
  "3": {"intro":["규칙은 전부 읽어 왔어요. 아마도요!","저, 실수해도 웃지 마세요."],"hit":["아이, 생각보다 빠르네요!","잠깐만요, 마음의 준비가…!"],"chain":["이런 건 설명서에 없었잖아요!"],"counter":["저도 용기 내서 갑니다!"],"heal":["물 한 잔 드실래요?"]},
  "4": {"intro":["지난 세션 데이터를 분석해 왔습니다.","오늘은 예상 승률을 뒤집어 보죠."],"hit":["그 움직임은 계산 밖인데요.","오차 범위가 커지고 있군요."],"chain":["연쇄 확률이 이렇게 높을 리가!"],"counter":["이번 수는 통계적으로 유리합니다."],"heal":["회복 효율도 기록하겠습니다."]},
  "5": {"intro":["오늘은 군더더기 없는 진행을 원해요.","첫 문장부터 매끄럽게 시작하죠."],"hit":["좋아요. 다만 호흡은 조금 더 정확하게.","흠, 수정할 곳이 거의 없네요."],"chain":["결말이 예상보다 강렬하군요."],"counter":["이제 제 차례를 교정해 드리죠."],"heal":["쉼표도 필요한 법이죠."]},
  "6": {"intro":["오늘 목표는 네 항목 모두 달성입니다.","흐트러짐 없는 세션을 부탁드려요."],"hit":["좋습니다. 흔들리지 마세요.","예상보다 큰 변동이군요."],"chain":["이건 복리처럼 늘어나는군요!"],"counter":["위험은 분산해야죠."],"heal":["재정비 후 다시 계산하죠."]},
  "7": {"intro":["리듬에 맞춰 시작해 볼까요?","세 박자 뒤에 큰 동작, 준비!"],"hit":["좋아요! 지금 박자예요!","앗, 스텝이 꼬였네!"],"chain":["이건 거의 앙코르 무대네요!"],"counter":["이번엔 제 춤을 보세요!"],"heal":["숨을 고르고, 하나 둘 셋!"]},
  "8": {"intro":["오늘은 활짝 피어나는 기분이에요.","한 번에 멋진 꽃다발을 만들어 봐요!"],"hit":["아야, 꽃잎이 흩날리겠어요!","우와, 생각보다 화끈한데요?"],"chain":["꽃이 한꺼번에 피는 것 같아요!"],"counter":["제 차례엔 반짝이는 꽃을!"],"heal":["잠깐 물 주는 시간이죠."]},
  "9": {"intro":["이번 판엔 새 조합을 시험할게요.","익숙한 공식은 조금 지루하잖아요?"],"hit":["오, 그 동선은 예쁜데요?","아뿔싸, 제 설계가 밀렸네요."],"chain":["이펙트가 아주 근사해요!"],"counter":["이번 시제품은 어떠세요?"],"heal":["리셋하고 다시 그려 봐요."]},
  "10": {"intro":["깔끔한 한 판? 제 취향은 아니죠.","오늘도 강렬하게 남겨 봅시다."],"hit":["좋아요, 그 정도는 돼야죠!","하, 손맛이 확실하네요."],"chain":["와, 이건 작품으로 남겨야겠어!"],"counter":["제가 새겨 넣을 차례네요."],"heal":["잠깐 잉크 말리는 시간!"]},
  "11": {"intro":["특별한 서비스, 기대하겠습니다.","오늘의 컨디션은 아주 좋습니다."],"hit":["후후, 세심하시군요.","어머, 예상보다 과감한 진행이네요."],"chain":["이 정도면 스위트룸급 연출이에요."],"counter":["이제 제가 응대할 차례입니다."],"heal":["잠시 쉬어 가시겠어요?"]},
  "12": {"intro":["자세를 낮추고, 시작합니다.","느린 판단은 바로 들켜요."],"hit":["터치가 정확하군요.","앗, 한 박자 늦었어요."],"chain":["연속 찌르기 같은 연쇄네요."],"counter":["지금은 제 공격권입니다."],"heal":["호흡, 거리, 다시 집중."]},
  "13": {"intro":["조건을 맞추면 좋은 거래가 되겠죠.","네 가지 목표, 모두 확인하겠습니다."],"hit":["그 제안은 수락할 만하네요.","허, 이런 변수는 없었는데요."],"chain":["예상 밖의 추가 조항이군요!"],"counter":["제 역제안도 들어 보세요."],"heal":["잠시 협상 휴식입니다."]},
  "14": {"intro":["규칙은 지키되, 빈틈은 찾겠습니다.","오늘은 판례 없는 승부를 해 보죠."],"hit":["이의 있습니다… 농담이에요.","흥미로운 증거가 나왔군요."],"chain":["이 연쇄는 판결을 바꾸겠는데요."],"counter":["반대 심문을 시작합니다."],"heal":["휴정 후 다시 속개하죠."]},
  "15": {"intro":["설계도 없이 무너지지는 않아요.","구조가 튼튼한지 확인해 보죠."],"hit":["예상과 다른 하중이네요.","좋아요, 균형이 바뀌었어요."],"chain":["와, 도미노처럼 완벽하네요!"],"counter":["이번엔 제 쪽에서 재설계합니다."],"heal":["기초부터 다시 다져요."]},
  "16": {"intro":["오래 기다린 만큼 좋은 세션을 바랍니다.","품격은 여유에서 나오는 법이지요."],"hit":["호호, 이 정도면 합격입니다.","어머나, 젊은 패기가 대단하군요."],"chain":["한 편의 공연을 보는 듯하네요."],"counter":["경험의 차이도 보여 드리지요."],"heal":["차 한 잔의 여유를 가지세요."]},
  "17": {"intro":["막이 올랐어요! 주인공은 누구죠?","오늘도 객석을 놀라게 해 봐요!"],"hit":["아아! 극적인 전개예요!","좋아요, 감정선을 더 올려요!"],"chain":["브라보! 커튼콜이 필요하겠어요!"],"counter":["이제 제 솔로 넘버입니다!"],"heal":["잠깐 인터미션이에요."]},
  "18": {"intro":["조용히… 시작해도 될까요?","오늘은 끝까지 집중해 보겠습니다."],"hit":["아, 제가 조금 놀랐어요.","생각보다 진도가 빠르네요."],"chain":["이건 강의자료에 넣고 싶어요."],"counter":["제 풀이도 한 번 봐 주세요."],"heal":["잠시 복습할 시간이네요."]},
  "19": {"intro":["체력은 자신 있어요. 들어오세요!","준비 운동은 충분히 하셨죠?"],"hit":["좋아! 바로 그 강도예요!","오, 꽤 묵직한 한 수네요."],"chain":["이게 진짜 서킷 트레이닝이지!"],"counter":["이제 제 인터벌입니다!"],"heal":["물 마시고 바로 재개해요."]},
  "20": {"intro":["오늘은 맛의 균형처럼 정확하게.","조금의 오차도 알아차릴 거예요."],"hit":["음, 강도가 딱 맞네요.","잠깐, 양념이 과해졌는데요?"],"chain":["와, 입안에서 터지는 연쇄 같아!"],"counter":["이번 코스는 제가 준비했어요."],"heal":["입가심하고 다시 시작하죠."]},
  "21": {"intro":["정답 없는 작품을 함께 만들어요.","오늘은 선을 어디까지 넘을까요?"],"hit":["오, 흥미로운 붓질이에요.","제가 그린 구도가 무너졌네요."],"chain":["이건 전시회 중앙에 걸어야 해요!"],"counter":["제 색깔도 한 번 보세요."],"heal":["여백을 남겨 두는 것도 예술이죠."]},
  "22": {"intro":["기대치를 높여도 괜찮겠죠?","브랜드 이름을 걸고 승부해요!"],"hit":["좋아요! 이 정도면 프리미엄이죠.","어머, 생각보다 놀라운 경험인데요?"],"chain":["이건 바로 캠페인 영상감이에요!"],"counter":["이번엔 제 전략을 보여 드릴게요."],"heal":["브레이크 타임도 전략이에요."]},
  "23": {"intro":["작품을 감상하듯 한 수씩 봅시다.","평범한 구성은 선호하지 않아요."],"hit":["절제된 움직임이 좋군요.","호오, 큐레이션을 바꿔야겠어요."],"chain":["기획하지 못한 명장면이네요."],"counter":["다음 장면은 제가 배치하죠."],"heal":["잠시 작품 사이를 거닐어요."]},
  "24": {"intro":["성장의 결과를 보여 주실 차례예요.","오늘은 최고 수준만 기대하겠습니다."],"hit":["흥, 그 정도라면 평가를 올리죠.","좋아요. 아직 더 남았겠지요?"],"chain":["드디어 제 기대를 넘어서는군요!"],"counter":["위험을 감수할 줄도 알아야지요."],"heal":["장기전에는 회복도 투자입니다."]}
}
